{
    "compilerOptions": {
        "lib": [
            "es2017",
            "dom",
            "esnext.asynciterable"
        ],
        "module": "commonjs",
        "target": "es2017",
        "experimentalDecorators": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "typeRoots": [
            "../node_modules/@types"
        ],
        "types": [
            "jest",
            "node",
            "react"
        ],
        "baseUrl": ".",
        "paths": {
            "@app/*": [
                "../src/*"
            ],
            "@utils": [
                "./_utils/index"
            ],
            "@navigation": [
                "./_utils/navigation/index"
            ],
            "@appScreens": [
                "./_utils/appScreens/index"
            ],
            "@ids": [
                "./_utils/navigation/ids"
            ],
            "@socket": [
                "./_utils/socket/index"
            ],
            "@dataManager": [
                "./dataManager"
            ],
            "@i18n": [
                "./_utils/i18n/index"
            ],
            "@images":[
                "./_utils/navigation/images/index.ts"
            ],
            "@yu-life/react-native-yu-health": [
                "../targets/YuHealth/src/index"
            ],
            "@yu-life/react-native-yu-health/*": [
                "../targets/YuHealth/src/*"
            ]
        }
    },
    "include": [
        "./**/*.ts",
        "./**/*.tsx"
    ],
    "exclude": [
        "node_modules",
        "../node_modules"
    ]
}