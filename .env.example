# Copy to .env.local.overrides (gitignored) and fill in real values for local app/e2e work.
# Do not commit secrets to this public repository.

ENV=dev
API_URL_UK=http://localhost:5000
API_URL_US=http://localhost:5000
API_URL_SA=http://localhost:5000
API_URL_JP=http://localhost:5000
API_URL_KSA=http://localhost:5000
MULTI_REGION_ENABLED=true

# Third-party SDK keys — obtain from your team secrets store
INTERCOM_API_KEY_IOS=
INTERCOM_API_KEY_ANDROID=
INTERCOM_APP_ID=
INTERCOM_GCM_SENDER_ID=
BUGSNAG_API_KEY=
YU_CLIENT_TOKEN=

# Tolgee — required for `pnpm translations:download:local`
TOLGEE_API_KEY=

PRIVACY_POLICY_URL="https://www.yulife.com/privacy-policy"
URL_SCHEME=yulifeapp-local
APPLE_TEAM_ID=
DISPLAY_NAME="YuLife (local)"
ANDROID_DEEP_LINK_APP_NAME=yulife-debug
APPLE_MERCHANT_IDENTIFIER=merchant.develop.yulife
USE_NEW_LOGIN_FLOW=true
HAS_THEME_ON_LOGIN=true
