{
    "defaultSeverity": "error",
    "extends": ["tslint:recommended", "tslint-react"],
    "jsRules": {},
    "rules": {
        "trailing-comma": [true, { "multiline": "never", "singleline": "never" }],
        "jsx-no-multiline-js": false,
        "jsx-no-lambda": false,
        "object-literal-sort-keys": true,
        "ordered-imports": true
    },
    "rulesDirectory": []
}
