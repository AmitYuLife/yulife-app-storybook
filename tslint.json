{
  "defaultSeverity": "error",
  "extends": ["tslint:recommended", "tslint-react"],
  "jsRules": {},
  "rules": {
    "semicolon": [true, "always", "ignore-bound-class-methods"],
    "trailing-comma": "es5",
    "jsx-no-multiline-js": false,
    "jsx-no-lambda": false,
    "object-literal-sort-keys": false
  },
  "linterOptions": {
    "exclude": ["e2e"]
  },
  "cliOptions": {
    "exclude": ["e2e"]
  },
  "rulesDirectory": []
}
