{
  "name": "yulife",
  "version": "1.6.0",
  "versionCode": 39,
  "private": true,
  "scripts": {
    "android:adb:reverse": "adb reverse tcp:8081 tcp:8081",
    "android:restart": "adb shell input text 'RR'",
    "android:menu": "adb shell input keyevent 82",
    "e2e:build": "ENVFILE=.env.local detox build",
    "e2e:build:release": "RN_SRC_EXT=e2e.ts ENVFILE=.env.local detox build -c ios.sim.release",
    "e2e:run": "SKIP_MANUAL=true TS_NODE_PROJECT=./e2e/tsconfig.json detox test -s 'e2e/**/*.spec.ts'",
    "e2e:run:release": "npm run e2e:run -- -c ios.sim.release --take-screenshots all --artifacts-location ./e2e/__report",
    "e2e:run:includeManual": "TS_NODE_PROJECT=./e2e/tsconfig.json detox test -s 'e2e/**/*.spec.ts'",
    "e2e:run:manualOnly": "TS_NODE_PROJECT=./e2e/tsconfig.json detox test -s e2e/**/*.manual.spec.ts",
    "start": "run-p start:bundler tsc:watch",
    "start:e2e": "RN_SRC_EXT=e2e.ts ENVFILE=.env.local run-p start:bundler tsc:watch",
    "start:storybook": "run-p storybook",
    "start:bundler": "react-native start --reset-cache",
    "start:ios": "react-native run-ios",
    "start:ios:local": "react-native run-ios --scheme=local",
    "start:ios:uat": "react-native run-ios --scheme=uat",
    "start:ios:production": "react-native run-ios --scheme=production",
    "start:android": "react-native run-android --variant=debug",
    "start:android:local": "react-native run-android --variant=local",
    "start:android:uat": "react-native run-android --variant=uat",
    "start:android:production": "react-native run-android --variant=production",
    "test": "run-s test:unit",
    "test:unit": "jest --config=jest.config.json",
    "test:all": "run-s tslint tsc test:unit",
    "tslint": "tslint -p tsconfig.json",
    "tslint:fix": "tslint -p tsconfig.json --fix",
    "build": "tsc -v && npm run tsc",
    "tsc": "tsc --noUnusedLocals --noUnusedParameters",
    "tsc:watch": "tsc --noUnusedLocals --noUnusedParameters --watch --pretty",
    "download-schema": "apollo-codegen download-schema http://yulife-api-server-develop.eu-west-2.elasticbeanstalk.com/graphql --output ./src/graphql/_core/schema.json",
    "download-schema-local": "apollo-codegen download-schema http://localhost:5000/graphql --output ./src/graphql/_core/schema.json",
    "generate-graphql-types": "apollo-codegen generate \"src/graphql/**/*.gql.ts{,?}\" --schema ./src/graphql/_core/schema.json --target ts --output ./src/graphql/_core/schema.ts",
    "prestorybook": "rnstl",
    "set-ios-version": "scripts/set-ios-version.sh",
    "storybook": "storybook start -p 7007",
    "bitrise:edit": "bitrise :workflow-editor",
    "set-bitrise-build-number": "node scripts/set-bitrise-build-number.js"
  },
  "dependencies": {
    "apollo-boost": "^0.1.15",
    "apollo-cache-persist": "^0.1.1",
    "apollo-link": "^1.2.2",
    "apollo-link-context": "^1.0.8",
    "apollo-link-error": "^1.1.0",
    "babel-plugin-module-resolver": "^3.1.1",
    "bugsnag-react-native": "^2.10.2",
    "cloudinary-core": "^2.5.0",
    "email-validator": "^2.0.4",
    "graphql": "^0.13.2",
    "react": "^16.6.1",
    "react-apollo": "^2.1.11",
    "react-native": "0.57.8",
    "react-native-animatable": "^1.3.1",
    "react-native-auto-height-image": "1.0.5",
    "react-native-blur": "^3.2.2",
    "react-native-config": "^0.11.5",
    "react-native-device-info": "^1.4.2",
    "react-native-fast-image": "^5.1.2",
    "react-native-fitkit": "ssh://git@gitlab.com:yu-life/react-native-fitkit.git",
    "react-native-intercom": "^12.0.0",
    "react-native-iphone-x-helper": "1.0.3",
    "react-native-mixpanel": "^1.1.1",
    "react-native-modal-datetime-picker": "^6.0.0",
    "react-native-navigation": "^2.13.2",
    "react-native-push-notification": "^3.1.2",
    "react-native-svg": "^9.0.0",
    "react-native-testfairy": "^2.17.0",
    "react-redux": "^5.0.7",
    "redux": "^4.0.0",
    "redux-persist": "^5.10.0",
    "redux-saga": "^0.16.0",
    "reselect": "^3.0.1",
    "socket.io-client": "^2.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@babel/plugin-external-helpers": "^7.0.0",
    "@storybook/addon-actions": "^3.4.10",
    "@storybook/addon-knobs": "^3.4.10",
    "@storybook/addon-links": "^3.4.10",
    "@storybook/addons": "^3.4.10",
    "@storybook/react-native": "^3.4.10",
    "@types/axios": "^0.14.0",
    "@types/detox": "^9.0.3",
    "@types/enzyme": "^3.1.13",
    "@types/express": "^4.16.0",
    "@types/jest": "^23.3.1",
    "@types/mocha": "^5.2.5",
    "@types/mongodb": "^3.1.22",
    "@types/node": "^10.9.4",
    "@types/react": "^16.4.11",
    "@types/react-native": "^0.57.8",
    "@types/react-native-mixpanel": "^0.1.0",
    "@types/react-native-push-notification": "^3.0.4",
    "@types/react-redux": "^6.0.6",
    "@types/react-test-renderer": "^16.0.2",
    "@types/socket.io": "^2.1.2",
    "@types/socket.io-client": "^1.4.32",
    "@types/storybook__addon-actions": "^3.4.1",
    "@types/storybook__addon-knobs": "^3.4.1",
    "@types/storybook__addon-links": "^3.3.2",
    "@types/storybook__react": "^3.0.9",
    "@types/storybook__react-native": "^3.0.1",
    "apollo-codegen": "^0.20.2",
    "axios": "^0.18.0",
    "babel-core": "^7.0.0-bridge.0",
    "babel-jest": "^23.4.2",
    "csvtojson": "^2.0.8",
    "detox": "^12.1.3",
    "enzyme": "^3.5.0",
    "enzyme-adapter-react-16": "^1.3.0",
    "express": "^4.16.4",
    "husky": "^1.0.0-rc.13",
    "jest": "^23.5.0",
    "metro-react-native-babel-preset": "^0.45.0",
    "mocha": "^5.2.0",
    "mochawesome": "^3.1.1",
    "mongodb": "^3.1.13",
    "npm-run-all": "^4.1.3",
    "prop-types": "^15.6.2",
    "react-dom": "^16.6.1",
    "react-native-storybook-loader": "^1.8.0",
    "react-native-typescript-transformer": "^1.2.11",
    "react-test-renderer": "16.6.1",
    "readline": "^1.3.0",
    "redux-devtools-extension": "^2.13.5",
    "socket.io": "^2.2.0",
    "ts-jest": "^23.1.4",
    "ts-node": "^7.0.1",
    "tsconfig-paths": "^3.7.0",
    "tslint": "^5.11.0",
    "tslint-react": "^3.6.0",
    "typescript": "^3.0.1"
  },
  "config": {
    "react-native-storybook-loader": {
      "searchDir": [
        "./src"
      ],
      "pattern": "**/*.stories.tsx",
      "outputFile": "./storybook/storyLoader.js"
    }
  },
  "rnpm": {
    "assets": [
      "./assets/fonts/"
    ]
  },
  "husky": {
    "hooks": {
      "pre-push": "run-s test:all"
    }
  },
  "prettier": {
    "arrowParens": "always",
    "printWidth": 120,
    "tabWidth": 4,
    "trailingComma": "none"
  },
  "detox": {
    "configurations": {
      "ios.sim.debug": {
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/YuLife.app",
        "build": "xcodebuild -project ios/YuLife.xcodeproj -scheme YuLife -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build -UseModernBuildSystem=NO",
        "type": "ios.simulator",
        "name": "iPhone 8"
      },
      "ios.sim.release": {
        "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/YuLife.app",
        "build": "xcodebuild -project ios/YuLife.xcodeproj -scheme YuLife -configuration Release -sdk iphonesimulator -derivedDataPath ios/build -UseModernBuildSystem=NO",
        "type": "ios.simulator",
        "name": "iPhone 8"
      }
    }
  }
}
