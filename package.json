{
  "name": "yulife",
  "version": "4.66.0",
  "private": true,
  "scripts": {
    "android:adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:7007 tcp:7007 && adb reverse tcp:5000 tcp:5000",
    "android:crashlogs": "adb logcat AndroidRuntime:E *:S",
    "android:menu": "adb shell input keyevent 82",
    "android:restart": "adb shell input text 'RR'",
    "clean:cache": "watchman watch-del-all && rm -rf $TMPDIR/react-* && rm -rf $TMPDIR/metro-bundler-cache-* && rm -rf ~/Library/Developer/Xcode/DerivedData && rm -rf node_modules/ && yarn",
    "detox:build": "ENVFILE=.env.e2e RN_SRC_EXT=e2e.ts,e2e.tsx detox build -c ios.sim.debug",
    "detox:build:android": "ENVFILE=.env.e2e RN_SRC_EXT=e2e.ts,e2e.tsx detox build -c android.emu.debug",
    "detox:build:translations": "node ./scripts/generate-detox-localisation-file.js",
    "detox:activity": "yarn detox:test:base:uk e2e/activity/cycling/*.spec.ts e2e/activity/duels/*.spec.ts e2e/activity/FWQ/*.spec.ts e2e/activity/leaderboard/*.spec.ts",
    "detox:activity:android": "yarn detox:test:base:uk:android e2e/activity/cycling/*.spec.ts e2e/activity/duels/*.spec.ts e2e/activity/FWQ/*.spec.ts e2e/activity/leaderboard/*.spec.ts",
    "detox:activity:2": "yarn detox:test:base:uk e2e/activity/mood_monitor/*.spec.ts e2e/activity/p2p_gifting/*.spec.ts e2e/activity/steps/*.spec.ts e2e/activity/streaks/*.spec.ts",
    "detox:admin": "yarn detox:test:base:uk e2e/admin/appreview/*.spec.ts e2e/admin/emails/*.spec.ts e2e/admin/feedback_forms/*.spec.ts e2e/admin/login_and_routing/*.spec.ts",
    "detox:admin:2": "yarn detox:test:base:uk e2e/admin/referrals/*.spec.ts e2e/admin/routing/*.spec.ts",
    "detox:battle-pass": "yarn detox:test:base:uk e2e/battle_pass/**/*.spec.ts",
    "detox:benefits": "yarn detox:test:base:uk e2e/benefits/**/*.spec.ts",
    "detox:challenges": "yarn detox:test:base:uk e2e/challenges/challenges/*.spec.ts e2e/challenges/events/*.spec.ts",
    "detox:challenges:2": "yarn detox:test:base:uk e2e/challenges/meditopia/*.spec.ts e2e/challenges/yudoku/*.spec.ts",
    "detox:challenges-extended": "yarn detox:test:base:uk e2e/challenges_extended/**/*.spec.ts",
    "detox:personal": "yarn detox:test:base:uk e2e/personal/**/*.spec.ts",
    "detox:report": "open e2e-report/jest_html_reporters.html",
    "detox:screenshots": "yarn detox:test:base:uk e2e/screenshots/**/*.spec.ts",
    "detox:sa": "yarn detox:test:base:uk e2e/south_africa/**/*.spec.ts",
    "detox:usa": "yarn detox:test:base:uk e2e/usa/**/*.spec.ts",
    "detox:jp": "yarn detox:test:base:jp e2e/japan/*.spec.ts",
    "detox:worlds": "yarn detox:test:base:uk e2e/worlds_progression/eotw/*.spec.ts",
    "detox:worlds:2": "yarn detox:test:base:uk e2e/worlds_progression/worlds/*.spec.ts e2e/worlds_progression/worlds_extended/*.spec.ts",
    "detox:yuscreen": "yarn detox:test:base:uk e2e/yuscreen/**/*.spec.ts",
    "detox:group-health": "yarn detox:test:base:uk e2e/group_health/*.spec.ts",
    "detox:group-health-two": "yarn detox:test:base:uk e2e/group_health_two/*.spec.ts",
    "detox:health": "yarn detox:test:base:uk e2e/health/*.spec.ts",
    "detox:test:all": "yarn detox:test:base e2e/**/*.spec.ts",
    "detox:test:base:sa": "API_URL=http://localhost:5002/  yarn detox:test:base",
    "detox:test:base:uk": "API_URL=http://localhost:5000/  yarn detox:test:base",
    "detox:test:base:uk:android": "API_URL=http://localhost:5000/  yarn detox:test:base:android",
    "detox:test:base:us": "API_URL=http://localhost:5001/  yarn detox:test:base",
    "detox:test:base:jp": "API_URL=http://localhost:5003/  yarn detox:test:base",
    "detox:test:base": "TS_NODE_PROJECT=./e2e/tsconfig.json yarn detox test -i --cleanup -c ios.sim.debug --loglevel verbose --json --outputFile=e2e-report/results.json",
    "detox:test:base:android": "TS_NODE_PROJECT=./e2e/tsconfig.json yarn detox test -i --cleanup -c android.emu.debug --loglevel verbose --json --outputFile=e2e-report/results.json",
    "detox:get:skips": "node ./scripts/get_e2e_skips.js",
    "detox:get:scenarios": "node ./scripts/get_e2e_scenarios.js",
    "develop:workflow": "bitrise :workflow-editor",
    "env:config:local": "echo '# Base\n' > .env.local && cat .env >> .env.local && [ -f .env.local.overrides ] && echo '\n\n# Overrides\n' >> .env.local && cat .env.local.overrides >> .env.local || true",
    "translations:push": "yulife-tolgee-cli upload-full",
    "translations:configs": "ts-node ./scripts/translate-configs.ts",
    "translations:download": "yulife-tolgee-cli download",
    "posttranslations:download": "yarn translations:configs && yarn watch:translations",
    "translations:download:local": "TOLGEE_API_KEY=tgpak_gmydqms7obrtemrvmezge5dmoruwimzrmq2tsolvmiyti2rumy yarn translations:download",
    "e2e:build": "tsc -p e2e --noEmit",
    "e2e:watch": "tsc -p e2e --noEmit --watch",
    "generate:gql:types": "graphql-codegen --config codegen.ts",
    "generate:gql:types:local": "yarn env:config:local && ENVFILE=.env.local graphql-codegen --config codegen.ts",
    "postgenerate:gql:types": "prettier src/graphql/__generated --write",
    "postgenerate:gql:types:local": "prettier src/graphql/__generated --write",
    "ios:record": "(rm simulator.mov || echo '') && xcrun simctl io booted recordVideo simulator.mov",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
    "postinstall": "patch-package",
    "prettify:graphql": "prettier src/graphql/_core --write",
    "reset:storybook": "node ./scripts/start-storybook reset",
    "start:all-devices": "./scripts/start-a-fuck-ton-of-devices.sh",
    "start:android:local": "yarn env:config:local && ENVFILE=.env.local yarn android",
    "start:android:production": "ENVFILE=.env.uat.production yarn android",
    "start:android:uat": "ENVFILE=.env.uat yarn android",
    "start:android": "ENVFILE=.env.develop yarn android",
    "start:android:e2e": "ENVFILE=.env.e2e yarn android",
    "start:bundler": "expo start --reset-cache --dev-client",
    "start:e2e": "RN_SRC_EXT=e2e.ts,e2e.tsx ENVFILE=.env.e2e run-p start:bundler tsc:watch e2e:watch",
    "start:ios:local": "yarn env:config:local && ENVFILE=.env.local yarn ios",
    "start:ios:production": "ENVFILE=.env.production yarn ios",
    "start:ios:uat": "ENVFILE=.env.uat yarn ios",
    "start:ios": "yarn ios",
    "start:storybook:web": "storybook dev ",
    "build:storybook:web": "yarn translations:download && storybook build",
    "pod:install": "cd ios && ENABLE_YUWATCH=1 bundle exec pod install --repo-update",
    "start": "run-p start:bundler tsc:watch",
    "test": "run-p lint tsc test:unit",
    "test:unit": "jest",
    "test:unit:watch": "jest --watch",
    "tsc:watch": "tsc --noUnusedLocals --noUnusedParameters --watch --pretty",
    "tsc": "tsc --noUnusedLocals --noUnusedParameters",
    "regenerate": "yarn env:config:local && ./scripts/generate-native-projects.sh",
    "watch:schema": "./ios/Pods/Apollo/apollo-ios-cli fetch-schema",
    "watch:codegen": "./ios/Pods/Apollo/apollo-ios-cli generate",
    "watch:translations": "ts-node ./scripts/watch-translations.ts",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "update": "yarn && yarn regenerate && yarn pod:install"
  },
