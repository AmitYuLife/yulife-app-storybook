{
  "name": "yulife",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "start:ios": "react-native run-ios",
    "start:android": "react-native run-android",
    "test": "jest --config=jest.config.json",
    "download-schema": "apollo-codegen download-schema http://yulife-api-server-develop.eu-west-2.elasticbeanstalk.com/graphql --output ./src/graphql/_core/schema.json",
    "download-schema-local": "apollo-codegen download-schema http://localhost:5000/graphql --output ./src/graphql/_core/schema.json",
    "generate-graphql-types": "apollo-codegen generate ./src/graphql/**/*.gql.ts --schema ./src/graphql/_core/schema.json --target ts --output ./src/graphql/_core/schema.ts",
    "prestorybook": "rnstl",
    "storybook": "storybook start -p 7007"
  },
  "dependencies": {
    "apollo-boost": "^0.1.12",
    "apollo-codegen": "^0.20.2",
    "apollo-link-context": "^1.0.8",
    "graphql": "^0.13.2",
    "react": "16.4.1",
    "react-apollo": "^2.1.9",
    "react-native": "0.56.0",
    "react-native-blur": "^3.2.2",
    "react-native-navigation": "^2.0.2431",
    "react-native-svg": "^6.5.0",
    "react-native-swiper": "^1.5.13"
  },
  "devDependencies": {
    "@storybook/addon-actions": "^3.4.8",
    "@storybook/addon-knobs": "^3.4.8",
    "@storybook/addon-links": "^3.4.8",
    "@storybook/addons": "^3.4.8",
    "@storybook/react-native": "^3.4.8",
    "@types/enzyme": "^3.1.12",
    "@types/jest": "^23.3.1",
    "@types/react": "^16.4.7",
    "@types/react-native": "^0.56.4",
    "@types/react-test-renderer": "^16.0.1",
    "@types/storybook__addon-actions": "^3.0.3",
    "@types/storybook__addon-knobs": "^3.3.1",
    "@types/storybook__addon-links": "^3.3.1",
    "@types/storybook__react": "^3.0.8",
    "@types/storybook__react-native": "^3.0.0",
    "babel-core": "^7.0.0-beta",
    "babel-jest": "^23.4.0",
    "babel-preset-react-native": "^5.0.2",
    "babel-runtime": "^7.0.0-beta",
    "enzyme": "^3.3.0",
    "enzyme-adapter-react-16": "^1.1.1",
    "jest": "23.4.1",
    "prop-types": "^15.6.2",
    "react-dom": "16.4.1",
    "react-native-storybook-loader": "^1.8.0",
    "react-native-typescript-transformer": "^1.2.10",
    "react-test-renderer": "16.4.1",
    "ts-jest": "^23.0.1",
    "tslint": "^5.11.0",
    "tslint-react": "^3.6.0",
    "typescript": "^2.9.2"
  },
  "config": {
    "react-native-storybook-loader": {
      "searchDir": [
        "./src"
      ],
      "pattern": "**/*.stories.tsx",
      "outputFile": "./storybook/storyLoader.js"
    }
  },
  "rnpm": {
    "assets": [
      "./assets/fonts/"
    ]
  }
}
