{
    "name": "yulife",
    "version": "2.9.0",
    "versionCode": 57,
    "private": true,
    "scripts": {
        "android:adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:7007 tcp:7007 && adb reverse tcp:5000 tcp:5000",
        "android:restart": "adb shell input text 'RR'",
        "android:menu": "adb shell input keyevent 82",
        "android:crashlogs": "adb logcat AndroidRuntime:E *:S",
        "clean:cache": "watchman watch-del-all && rm -rf $TMPDIR/react-* && rm -rf $TMPDIR/metro-bundler-cache-* && rm -rf ~/Library/Developer/Xcode/DerivedData && rm -rf node_modules/ && yarn",
        "detox:build": "ENVFILE=.env.e2e RN_SRC_EXT=e2e.ts,e2e.tsx detox build -c ios.sim.debug",
        "detox:test:base": "TS_NODE_PROJECT=./e2e/tsconfig.json yarn detox test --cleanup -c ios.sim.debug --loglevel verbose e2e/init.ts",
        "detox:test:all": "yarn detox:test:base e2e/**/*.spec.ts",
        "detox:smoke": "yarn detox:test:base e2e/00_Smoke/**/*.spec.ts",
        "detox:extended": "yarn detox:test:base e2e/02_Extended/**/*.spec.ts",
        "detox:report": "open e2e-report/mochawesome.html",
        "ios:record": "(rm simulator.mov || echo '') && xcrun simctl io booted recordVideo simulator.mov",
        "start:android": "react-native run-android --variant=debug",
        "start:android:local": "react-native run-android --variant=local",
        "start:android:uat": "react-native run-android --variant=uat",
        "start:android:production": "react-native run-android --variant=production",
        "start:all-devices": "./scripts/start-a-fuck-ton-of-devices.sh",
        "start:ios": "react-native run-ios",
        "start:ios:local": "react-native run-ios --scheme=local",
        "start:ios:uat": "react-native run-ios --scheme=uat",
        "start:ios:production": "react-native run-ios --scheme=production",
        "start": "run-p start:bundler tsc:watch",
        "start:e2e": "RN_SRC_EXT=e2e.ts,e2e.tsx ENVFILE=.env.e2e run-p start:bundler tsc:watch",
        "start:bundler": "react-native start --reset-cache",
        "start:storybook": "node ./scripts/start-storybook && start-storybook -p 7007",
        "start:storybook:browser": "node ./scripts/start-storybook browser && start-storybook -p 7007",
        "reset:storybook": "node ./scripts/start-storybook reset",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
        "test:all": "run-s test:lint tsc test",
        "tsc": "tsc --noUnusedLocals --noUnusedParameters",
        "tsc:watch": "tsc --noUnusedLocals --noUnusedParameters --watch --pretty",
        "download:schema": "apollo client:download-schema --endpoint=http://yulife-api-server-develop.eu-west-2.elasticbeanstalk.com/graphql ./src/graphql/_core/schema.json",
        "download:schema:local": "apollo client:download-schema --endpoint=http://localhost:5000/graphql ./src/graphql/_core/schema.json",
        "pregenerate:gql:types": "rm -rf ./src/graphql/_core/schema && mkdir ./src/graphql/_core/schema",
        "generate:gql:types": "apollo client:codegen --tagName=gql --localSchemaFile=./src/graphql/_core/schema.json --target=typescript --no-addTypename --outputFlat src/graphql/_core/schema",
        "postgenerate:gql:types": "node ./scripts/generate-index-schema-file-gql.js",
        "postinstall": "jetify && patch-package",
        "snyk-protect": "snyk protect",
        "prepublish": "yarn snyk-protect"
    },
    "dependencies": {
        "@apollo/react-common": "^3.1.4",
        "@apollo/react-hooks": "^3.1.4",
        "@react-native-community/async-storage": "^1.11.0",
        "@react-native-community/datetimepicker": "^3.0.2",
        "@react-native-community/netinfo": "^5.9.2",
        "@react-native-community/push-notification-ios": "^1.6.1",
        "@use-it/interval": "0.1.3",
        "apollo-boost": "^0.4.7",
        "apollo-cache-persist": "^0.1.1",
        "apollo-link": "^1.2.13",
        "apollo-link-context": "^1.0.19",
        "apollo-link-error": "^1.1.12",
        "apollo-link-retry": "^2.2.16",
        "bugsnag-react-native": "^2.23.6",
        "cloudinary-core": "^2.8.2",
        "email-validator": "^2.0.4",
        "graphql": "^14.6.0",
        "lottie-ios": "^3.1.8",
        "lottie-react-native": "^3.5.0",
        "moment": "^2.24.0",
        "react": "16.13.1",
        "react-native": "0.63.2",
        "react-native-animatable": "^1.3.3",
        "react-native-auto-height-image": "^3.0.0",
        "react-native-blur": "^3.2.2",
        "react-native-config": "^1.0.0",
        "react-native-device-info": "^7.0.2",
        "react-native-fast-image": "^8.3.2",
        "react-native-fitkit": "ssh://git@gitlab.com:yu-life/react-native-fitkit.git#0667969bf635fdeaa5165068b7c9296780bc6422",
        "react-native-intercom": "^16.0.0",
        "react-native-iphone-x-helper": "^1.2.1",
        "react-native-largelist-v3": "^3.0.15",
        "react-native-linear-gradient": "^2.5.6",
        "react-native-mixpanel": "^1.2.0",
        "react-native-modal-datetime-picker": "^8.5.1",
        "react-native-navigation": "^6.3.2",
        "react-native-push-notification": "^6.1.2",
        "react-native-spring-scrollview": "^2.0.23",
        "react-native-svg": "^12.1.0",
        "react-native-webview": "^11.0.0",
        "react-redux": "^7.2.0",
        "redux": "^4.0.5",
        "redux-persist": "^6.0.0",
        "redux-saga": "^1.1.3",
        "reselect": "^4.0.0",
        "simple-markdown": "^0.7.2",
        "snyk": "^1.316.1",
        "tipsi-stripe": "^8.0.0-beta.11"
    },
    "devDependencies": {
        "@apollo/react-testing": "^3.1.4",
        "@babel/core": "^7.8.4",
        "@babel/runtime": "^7.8.4",
        "@react-native-community/eslint-config": "^1.1.0",
        "@react-native-community/slider": "^3.0.3",
        "@storybook/addon-actions": "^5.3.18",
        "@storybook/addon-knobs": "5.3.18",
        "@storybook/addon-links": "^5.3.18",
        "@storybook/addon-ondevice-knobs": "5.3.18",
        "@storybook/addons": "^5.3.18",
        "@storybook/react-native": "^5.3.18",
        "@storybook/react-native-server": "^5.3.18",
        "@testing-library/jest-native": "^3.2.0",
        "@testing-library/react-hooks": "^3.4.1",
        "@testing-library/react-native": "^6.0.0",
        "@types/detox": "^16.4.1",
        "@types/jest": "^24.0.24",
        "@types/mocha": "^7.0.2",
        "@types/node": "^10.9.4",
        "@types/react": "^16.9.34",
        "@types/react-native": "^0.63.2",
        "@types/react-native-mixpanel": "^0.1.0",
        "@types/react-native-push-notification": "^5.0.5",
        "@types/react-redux": "^7.1.7",
        "@types/react-test-renderer": "16.9.1",
        "@types/socket.io": "^2.1.4",
        "@types/socket.io-client": "^1.4.32",
        "@typescript-eslint/eslint-plugin": "^2.28.0",
        "@typescript-eslint/parser": "^2.28.0",
        "apollo": "^2.26.0",
        "babel-jest": "^25.3.0",
        "babel-loader": "^8.1.0",
        "babel-plugin-module-resolver": "^4.0.0",
        "bcryptjs": "^2.4.3",
        "detox": "^16.9.2",
        "eslint": "^6.8.0",
        "eslint-config-prettier": "^6.10.1",
        "eslint-config-react": "^1.1.7",
        "eslint-plugin-prettier": "^3.1.3",
        "eslint-plugin-react": "^7.19.0",
        "eslint-plugin-react-hooks": "^3.0.0",
        "eslint-plugin-yulife-rn-client": "file:./yu-eslint",
        "express": "^4.17.1",
        "glob": "^7.1.6",
        "husky": "^4.2.3",
        "jest": "^25.3.0",
        "jest-watch-typeahead": "^0.6.0",
        "keypress-prompt": "^0.3.2",
        "lint-staged": "^10.2.11",
        "metro-react-native-babel-preset": "^0.59.0",
        "mocha": "^7.1.1",
        "mochawesome": "^6.1.0",
        "npm-run-all": "^4.1.5",
        "patch-package": "^6.2.1",
        "prettier": "^2.0.4",
        "react-dom": "^16.13.1",
        "react-test-renderer": "16.13.1",
        "readline": "^1.3.0",
        "redux-devtools-extension": "^2.13.8",
        "request-promise": "^4.2.5",
        "rimraf": "^3.0.2",
        "socket.io": "^2.3.0",
        "socket.io-client": "^2.3.0",
        "ts-jest": "^25.3.1",
        "ts-node": "^8.9.0",
        "tsconfig-paths": "^3.9.0",
        "typescript": "^3.9.5",
        "yulife-scripts": "git+ssh://git@gitlab.com:yu-life/yulife-scripts#836c94e7805b8f76aded8067f79ba2b5dccd568d"
    },
    "prettier": {
        "arrowParens": "always",
        "printWidth": 120,
        "tabWidth": 2,
        "trailingComma": "es5"
    },
    "rnpm": {
        "assets": [
            "./assets/fonts/"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged",
            "pre-push": "yarn test:all"
        }
    },
    "detox": {
        "configurations": {
            "ios.sim.debug": {
                "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/YuLife.app",
                "build": "xcodebuild -workspace ios/YuLife.xcworkspace -scheme local -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build",
                "type": "ios.simulator",
                "device": {
                    "type": "iPhone 11 Pro"
                }
            },
            "ios.sim.release": {
                "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/YuLife.app",
                "build": "xcodebuild -workspace ios/YuLife.xcworkspace -scheme local -configuration Release -sdk iphonesimulator -derivedDataPath ios/build",
                "type": "ios.simulator",
                "name": "iPhone 11 Pro"
            }
        },
        "test-runner": "mocha"
    },
    "snyk": true
}
