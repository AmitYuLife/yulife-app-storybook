{
  "name": "yulife",
  "version": "3.74.0",
  "versionCode": 57,
  "private": true,
  "scripts": {
    "android:adb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:7007 tcp:7007 && adb reverse tcp:5000 tcp:5000",
    "android:restart": "adb shell input text 'RR'",
    "android:menu": "adb shell input keyevent 82",
    "android:crashlogs": "adb logcat AndroidRuntime:E *:S",
    "clean:cache": "watchman watch-del-all && rm -rf $TMPDIR/react-* && rm -rf $TMPDIR/metro-bundler-cache-* && rm -rf ~/Library/Developer/Xcode/DerivedData && rm -rf node_modules/ && yarn",
    "detox:build": "ENVFILE=.env.e2e RN_SRC_EXT=e2e.ts,e2e.tsx detox build -c ios.sim.debug",
    "detox:test:base": "TS_NODE_PROJECT=./e2e/tsconfig.json yarn detox test --cleanup -c ios.sim.debug --loglevel verbose e2e/init.ts",
    "detox:test:base:uk": "API_URL=http://localhost:5000/  yarn detox:test:base",
    "detox:test:base:us": "API_URL=http://localhost:5001/  yarn detox:test:base",
    "detox:test:base:sa": "API_URL=http://localhost:5002/  yarn detox:test:base",
    "detox:test:all": "yarn detox:test:base e2e/**/*.spec.ts",
    "detox:smoke": "yarn detox:test:base:uk e2e/00_Smoke_*/**/*.spec.ts",
    "detox:smoke:1": "yarn detox:test:base:uk e2e/00_Smoke_1/**/*.spec.ts",
    "detox:smoke:2": "yarn detox:test:base:uk e2e/00_Smoke_2/**/*.spec.ts",
    "detox:smoke:3": "yarn detox:test:base:uk e2e/00_Smoke_3/**/*.spec.ts",
    "detox:extended": "yarn detox:test:base:uk e2e/01_Extended_*/**/*.spec.ts",
    "detox:extended:1": "yarn detox:test:base:uk e2e/01_Extended_1/**/*.spec.ts",
    "detox:extended:2": "yarn detox:test:base:uk e2e/01_Extended_2/**/*.spec.ts",
    "detox:extended:3": "yarn detox:test:base:uk e2e/01_Extended_3/**/*.spec.ts",
    "detox:pli:1": "yarn detox:test:base:uk e2e/02_PLI_1/*.spec.ts",
    "detox:pli:2": "yarn detox:test:base:uk e2e/02_PLI_2/*.spec.ts",
    "detox:dental": "yarn detox:test:base:uk e2e/03_Dental/**/*.spec.ts",
    "detox:usa": "yarn detox:test:base:us e2e/04_USA/**/*.spec.ts",
    "detox:report": "open e2e-report/mochawesome.html",
    "lint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
    "ios:record": "(rm simulator.mov || echo '') && xcrun simctl io booted recordVideo simulator.mov",
    "start:android": "ENVFILE=.env.develop react-native run-android --variant=debug --appIdSuffix debug",
    "start:android:local": "ENVFILE=.env.local react-native run-android --variant=local --appIdSuffix debug",
    "start:android:uat": "ENVFILE=.env.uat react-native run-android --variant=uat --appIdSuffix debug",
    "start:android:production": "ENVFILE=.env.uat.production react-native run-android --variant=production --appIdSuffix debug",
    "start:all-devices": "./scripts/start-a-fuck-ton-of-devices.sh",
    "start:ios": "react-native run-ios",
    "start:ios:local": "ENVFILE=.env.local react-native run-ios --scheme=local",
    "start:ios:uat": "ENVFILE=.env.uat react-native run-ios --scheme=uat",
    "start:ios:production": "ENVFILE=.env.production react-native run-ios --scheme=production",
    "start": "run-p start:bundler tsc:watch",
    "start:e2e": "RN_SRC_EXT=e2e.ts,e2e.tsx ENVFILE=.env.e2e run-p start:bundler tsc:watch",
    "start:bundler": "react-native start --reset-cache",
    "start:storybook": "node ./scripts/start-storybook && start-storybook -p 7007",
    "start:storybook:browser": "node ./scripts/start-storybook browser && start-storybook -p 7007",
    "start:storybook:web": "start-storybook -s ./assets",
    "build:storybook:web": "build-storybook -s ./assets",
    "reset:storybook": "node ./scripts/start-storybook reset",
    "test": "run-p lint tsc",
    "tsc": "tsc --noUnusedLocals --noUnusedParameters",
    "tsc:watch": "tsc --noUnusedLocals --noUnusedParameters --watch --pretty",
    "download:schema": "npx apollo client:download-schema --endpoint=https://develop.eu-west-2.api.yulife.engineering/graphql ./src/graphql/_core/schema.json",
    "download:schema:local": "npx apollo client:download-schema --endpoint=http://localhost:5000/graphql ./src/graphql/_core/schema.json",
    "pregenerate:gql:types": "rm -rf ./src/graphql/_core/schema && mkdir ./src/graphql/_core/schema",
    "generate:gql:types": "npx apollo client:codegen --tagName=gql --localSchemaFile=./src/graphql/_core/schema.json --target=typescript --no-addTypename --outputFlat src/graphql/_core/schema",
    "postgenerate:gql:types": "run-s generate:index:schema prettify:graphql",
    "generate:index:schema": "node ./scripts/generate-index-schema-file-gql.js",
    "prettify:graphql": "prettier src/graphql/_core --write",
    "postinstall": "patch-package",
    "snyk-protect": "snyk protect",
    "prepublish": "yarn snyk-protect"
  },
  "dependencies": {
    "@apollo/client": "^3.7.3",
    "@bugsnag/plugin-react-native-navigation": "^7.18.0",
    "@bugsnag/react-native": "^7.18.2",
    "@intercom/intercom-react-native": "^4.0.1",
