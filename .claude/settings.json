{
  "permissions": {
    "additionalDirectories": ["../yulife-api-server"],
    "allow": [
      "Edit(*)",
      "Write(*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(glab mr:*)",
      "Bash(pnpm eslint:*)",
      "Bash(pnpm jest:*)",
      "Bash(pnpm tsc:*)",
      "Bash(pnpm test:unit:*)",
      "Bash(pnpm generate:gql:types:local:*)",
      "Bash(pnpm update)",
      "mcp__ide__getDiagnostics",
      "Bash(pnpm start:e2e:*)",
      "Bash(pnpm detox:run:*)",
      "Bash(applesimutils:*)",
      "Bash(xcrun simctl:*)",
      "Bash(pnpm detox:build)",
      "Bash(CI=true pnpm detox:run:*)",
      "Bash(pnpm e2e:build:*)"
    ],
    "deny": [
      "Bash(pod install:*)"
    ],
    "ask": []
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "expo@claude-plugins-official": true
  }
}
