-    RCTFabricSurface *surface = [host createSurfaceWithModuleName:moduleName
-                                                initialProperties:initialProperties];
-    [host.surfacePresenter addObserver:self];
+    id<RCTSurfacePresenterStub> presenter = host.surfacePresenter;
+    // Create surface directly instead of [host createSurfaceWithModuleName:]
+    // to avoid adding to RCTHost._attachedSurfaces. This prevents RCTHost
+    // from restarting RNN-managed surfaces on reload.
+    RCTFabricSurface *surface = [[RCTFabricSurface alloc]
+        initWithSurfacePresenter:(RCTSurfacePresenter *)presenter
+                      moduleName:moduleName
+               initialProperties:initialProperties];
+    [presenter addObserver:self];
     self = [super initWithSurface:surface sizeMeasureMode:sizeMeasureMode];
-    
+
+    _surfacePresenter = presenter;
     _reactViewReadyBlock = reactViewReadyBlock;
     _eventEmitter = eventEmitter;
-    
+
+    [surface start];
+
     return self;
 }
+
+- (void)dealloc {
+    [_surfacePresenter removeObserver:self];
+}
 #endif
 
